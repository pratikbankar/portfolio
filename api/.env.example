# Copy to .env for local development.
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (or a local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
# Public URL of the Next.js app, no trailing slash
WEB_ORIGIN=http://localhost:3000
# Shared with the web app, at least 16 characters: openssl rand -hex 16
REVALIDATE_SECRET=
# Admin account created by `npm run seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
