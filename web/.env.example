# Copy to .env.local for local development.
# Base URL of the Express API, no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of this site, no trailing slash (used for canonical URLs, sitemap and Open Graph).
# Optional on Vercel, where it defaults to the project's production address. Set it once you add a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Must match REVALIDATE_SECRET on the API
REVALIDATE_SECRET=
